# MinIO (server-side — usado por docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000

# Buckets separados por ambiente
# (regra de prod: dev nunca compartilha storage com prod)
MINIO_BUCKET_DEV=desafio-bd-uc-dev
MINIO_BUCKET_PROD=desafio-bd-uc-prod

# DuckDB — arquivos separados por ambiente
# (regra de prod: erro em dev nunca corrompe o warehouse de prod)
DUCKDB_PATH_DEV=./data/warehouse_dev.duckdb
DUCKDB_PATH_PROD=./data/warehouse_prod.duckdb

# Datasets/schemas dbt
DBT_DATASET_DEV_STAGING=br_mma_unidades_conservacao_dev_staging
DBT_DATASET_DEV=br_mma_unidades_conservacao_dev
DBT_DATASET_PROD_STAGING=br_mma_unidades_conservacao_staging
DBT_DATASET_PROD=br_mma_unidades_conservacao

# Fonte
SOURCE_URL=https://dados.mma.gov.br/dataset/unidadesdeconservacao/resource/REPLACE_ME